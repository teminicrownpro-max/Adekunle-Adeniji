e="1" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;&amp;laquo;extend&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;i&gt;[customer wants beer]&lt;/i&gt;" style="endArrow=open;endFill=0;endSize=11;dashed=1;html=1;strokeColor=#b45309;fontColor=#b45309;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Inter;" edge="1" parent="1" source="UC05" target="UC01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;&amp;laquo;extend&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;i&gt;[paying by debit/credit]&lt;/i&gt;" style="endArrow=open;endFill=0;endSize=11;dashed=1;html=1;strokeColor=#b45309;fontColor=#b45309;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Inter;" edge="1" parent="1" source="UC09" target="UC03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;&amp;laquo;extend&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;i&gt;[customer chooses to tip]&lt;/i&gt;" style="endArrow=open;endFill=0;endSize=11;dashed=1;html=1;strokeColor=#b45309;fontColor=#b45309;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Inter;" edge="1" parent="1" source="UC10" target="UC03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&amp;nbsp;&amp;nbsp; Solid line = association &amp;nbsp;|&amp;nbsp; &lt;span style=&#x27;color:#1d4ed8&#x27;&gt;&lt;b&gt;&amp;laquo;include&amp;raquo;&lt;/b&gt;&lt;/span&gt; dashed arrow = mandatory, points to the included use case &amp;nbsp;|&amp;nbsp; &lt;span style=&#x27;color:#b45309&#x27;&gt;&lt;b&gt;&amp;laquo;extend&amp;raquo;&lt;/b&gt;&lt;/span&gt; dashed arrow = optional, runs only if [condition] is true, points to the base use case &amp;nbsp;|&amp;nbsp; Shaded oval = base use case" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;spacingLeft=10;fontSize=10.5;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="1020" height="50" as="geometry"/